<?xml version="1.0" encoding="utf-8"?>
<!-- Zapparr's settings, laid out like TiviMate's: the sections down the left, the focused
     section's options on the right. Focusing a section shows its options; Right goes into them. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/safe_horizontal"
    android:paddingTop="@dimen/safe_vertical"
    android:paddingEnd="@dimen/safe_horizontal">

    <TextView
        android:id="@+id/settings_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/ic_bolt"
        android:drawableTint="?attr/zAccent"
        android:gravity="center_vertical"
        android:text="@string/settings_title"
        android:textColor="?attr/zText"
        android:textSize="28sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/settings_header"
        android:layout_marginTop="24dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/settings_sections"
            android:layout_width="@dimen/settings_sections_width"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="32dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/safe_vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/settings_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</RelativeLayout>
