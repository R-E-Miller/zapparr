<?xml version="1.0" encoding="utf-8"?>
<!-- A palette: a small screen in its colors, and its name. The focus ring is in the palette in use. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/card_width"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/palette_frame"
        android:layout_width="@dimen/card_width"
        android:layout_height="@dimen/card_height"
        android:duplicateParentState="true"
        android:foreground="@drawable/tile_focus">

        <tv.zapparr.look.PaletteSwatch
            android:id="@+id/palette_swatch"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <TextView
        android:id="@+id/palette_name"
        android:layout_width="match_parent"
        android:layout_height="@dimen/palette_name_height"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/zText"
        android:textSize="@dimen/tile_caption_text" />
</LinearLayout>
