<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <TextView
        android:id="@+id/row_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:textColor="?attr/zTextDim"
        android:textSize="@dimen/row_title_text" />

    <TextView
        android:id="@+id/row_hint"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tile_height"
        android:gravity="center_vertical"
        android:textColor="?attr/zTextFaint"
        android:textSize="@dimen/body_text" />

    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/row_tiles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:horizontalSpacing="@dimen/tile_spacing"
        app:rowHeight="wrap_content" />
</LinearLayout>
