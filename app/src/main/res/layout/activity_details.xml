<?xml version="1.0" encoding="utf-8"?>
<!-- A movie or a series: the backdrop behind a scrim, the details, Play or Resume, and for a series
     its seasons and episodes. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/details_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/details_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/safe_horizontal"
        android:paddingTop="@dimen/details_top"
        android:paddingEnd="@dimen/safe_horizontal">

        <TextView
            android:id="@+id/details_title"
            android:layout_width="@dimen/details_width"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/zText"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/details_meta"
            style="@style/Zapparr.GuideDetail"
            android:layout_width="@dimen/details_width"
            android:layout_marginTop="8dp"
            android:textColor="?attr/zTextDim" />

        <TextView
            android:id="@+id/details_plot"
            style="@style/Zapparr.GuideDetail"
            android:layout_width="@dimen/details_width"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="4"
            android:textColor="?attr/zText" />

        <TextView
            android:id="@+id/details_people"
            style="@style/Zapparr.GuideDetail"
            android:layout_width="@dimen/details_width"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/zTextFaint"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/details_play"
                style="@style/Zapparr.Action"
                android:layout_marginTop="24dp" />

            <Button
                android:id="@+id/details_restart"
                style="@style/Zapparr.Action"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/details_restart"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/details_status"
            style="@style/Zapparr.GuideDetail"
            android:layout_marginTop="16dp"
            android:textColor="?attr/zTextDim" />

        <!-- A series: its seasons, and the chosen season's episodes. -->
        <HorizontalScrollView
            android:id="@+id/details_seasons_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/details_seasons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/details_episodes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="@dimen/safe_vertical"
            android:verticalSpacing="8dp"
            android:visibility="gone"
            app:focusOutFront="true" />
    </LinearLayout>
</merge>
