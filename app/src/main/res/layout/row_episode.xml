<?xml version="1.0" encoding="utf-8"?>
<!-- One episode: its still with how far it was watched, its number and title, and its description. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/episode_background"
    android:baselineAligned="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="horizontal"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="@dimen/still_width"
        android:layout_height="@dimen/still_height"
        android:background="@drawable/tile_background">

        <ImageView
            android:id="@+id/episode_still"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ProgressBar
            android:id="@+id/episode_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progressTint="?attr/zAccent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/episode_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/action_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/episode_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:duplicateParentState="true"
            android:singleLine="true"
            android:textColor="@color/episode_detail_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/episode_plot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/episode_detail_text"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
