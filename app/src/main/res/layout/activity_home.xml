<?xml version="1.0" encoding="utf-8"?>
<!-- The theme's window background paints the screen once. Clip nothing on the way down:
     focused tiles scale up past their rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/safe_horizontal"
        android:paddingTop="@dimen/safe_vertical"
        android:paddingEnd="@dimen/safe_horizontal">

        <TextView
            android:id="@+id/tab_apps"
            style="@style/Zapparr.Tab"
            android:text="@string/deck_apps" />

        <TextView
            android:id="@+id/tab_guide"
            style="@style/Zapparr.Tab"
            android:text="@string/deck_guide" />

        <TextView
            android:id="@+id/tab_library"
            style="@style/Zapparr.Tab"
            android:text="@string/deck_library" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:format12Hour="EEE, MMM d"
            android:format24Hour="EEE, d MMM"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/text_primary"
            android:textSize="30sp" />

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/round_button"
            android:contentDescription="@string/settings"
            android:focusableInTouchMode="true"
            android:scaleType="center"
            android:src="@drawable/ic_settings"
            android:tint="@color/icon_tint" />
    </LinearLayout>

    <tv.zapparr.home.DeckPager
        android:id="@+id/decks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:focusedByDefault="true">

        <FrameLayout
            android:id="@+id/deck_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <!-- focusOutFront: Up from the top row leaves the grid for the Settings button. -->
            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/apps_rows"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="@dimen/safe_horizontal"
                android:paddingTop="@dimen/deck_top"
                android:paddingEnd="@dimen/safe_horizontal"
                android:paddingBottom="@dimen/safe_vertical"
                android:verticalSpacing="@dimen/row_spacing"
                app:focusOutFront="true" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/deck_guide"
            style="@style/Zapparr.Placeholder">

            <TextView
                style="@style/Zapparr.PlaceholderTitle"
                android:text="@string/guide_title" />

            <TextView
                style="@style/Zapparr.PlaceholderBody"
                android:text="@string/guide_body" />

            <Button
                android:id="@+id/guide_action"
                style="@style/Zapparr.Action" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/deck_library"
            style="@style/Zapparr.Placeholder">

            <TextView
                style="@style/Zapparr.PlaceholderTitle"
                android:text="@string/library_title" />

            <TextView
                style="@style/Zapparr.PlaceholderBody"
                android:text="@string/library_body" />

            <Button
                android:id="@+id/library_action"
                style="@style/Zapparr.Action" />
        </LinearLayout>
    </tv.zapparr.home.DeckPager>
</LinearLayout>
