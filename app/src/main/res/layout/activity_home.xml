<?xml version="1.0" encoding="utf-8"?>
<!-- The theme's window background paints the screen once. Clip nothing on the way down:
     focused tiles scale up past their rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/tab_bar_start"
        android:paddingTop="@dimen/safe_vertical"
        android:paddingEnd="@dimen/safe_horizontal">

        <!-- The tabs and the Settings button: Up from any deck reaches its tab. -->
        <TextView
            android:id="@+id/tab_apps"
            style="@style/Zapparr.Tab"
            android:text="@string/deck_apps" />

        <TextView
            android:id="@+id/tab_guide"
            style="@style/Zapparr.Tab"
            android:text="@string/deck_guide" />

        <TextView
            android:id="@+id/tab_library"
            style="@style/Zapparr.Tab"
            android:text="@string/deck_library" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:format12Hour="EEE, MMM d"
            android:format24Hour="EEE, d MMM"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/text_primary"
            android:textSize="30sp" />

        <ImageButton
            android:id="@+id/settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="24dp"
            android:background="@drawable/round_button"
            android:contentDescription="@string/settings"
            android:focusableInTouchMode="true"
            android:scaleType="center"
            android:src="@drawable/ic_settings"
            android:tint="@color/icon_tint" />
    </LinearLayout>

    <tv.zapparr.home.DeckPager
        android:id="@+id/decks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:focusedByDefault="true">

        <FrameLayout
            android:id="@+id/deck_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <!-- focusOutFront: Up from the top row leaves the grid for the Settings button. -->
            <androidx.leanback.widget.VerticalGridView
                android:id="@+id/apps_rows"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="@dimen/safe_horizontal"
                android:paddingTop="@dimen/deck_top"
                android:paddingEnd="@dimen/safe_horizontal"
                android:paddingBottom="@dimen/safe_vertical"
                android:verticalSpacing="@dimen/row_spacing"
                app:focusOutFront="true" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/deck_guide"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Until channels load: a message, and a button to the server screen. -->
            <LinearLayout
                android:id="@+id/guide_message"
                style="@style/Zapparr.Placeholder">

                <TextView
                    style="@style/Zapparr.PlaceholderTitle"
                    android:text="@string/guide_title" />

                <TextView
                    android:id="@+id/guide_body"
                    style="@style/Zapparr.PlaceholderBody"
                    android:text="@string/guide_not_set_up" />

                <Button
                    android:id="@+id/guide_action"
                    style="@style/Zapparr.Action" />
            </LinearLayout>

            <!-- Once they have: the focused program's details, the filters, and the grid, which
                 takes focus when the deck opens. -->
            <LinearLayout
                android:id="@+id/guide_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="@dimen/safe_horizontal"
                android:paddingTop="@dimen/guide_top"
                android:paddingEnd="@dimen/safe_horizontal"
                android:paddingBottom="@dimen/safe_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/guide_program_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/guide_program_details"
                    style="@style/Zapparr.GuideDetail"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/guide_program_description"
                    style="@style/Zapparr.GuideDetail"
                    android:ellipsize="end"
                    android:lines="2"
                    android:textColor="@color/text_tertiary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/guide_filters"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/guide_settings"
                        style="@style/Zapparr.Chip"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="0dp"
                        android:text="@string/guide_server" />
                </LinearLayout>

                <tv.zapparr.live.GuideView
                    android:id="@+id/guide_grid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:focusedByDefault="true" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/deck_library"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <!-- Until the library loads: a message, and a button to the library server screen. -->
            <LinearLayout
                android:id="@+id/library_message"
                style="@style/Zapparr.Placeholder">

                <TextView
                    style="@style/Zapparr.PlaceholderTitle"
                    android:text="@string/library_title" />

                <TextView
                    android:id="@+id/library_body"
                    style="@style/Zapparr.PlaceholderBody"
                    android:text="@string/library_not_set_up" />

                <Button
                    android:id="@+id/library_action"
                    style="@style/Zapparr.Action" />
            </LinearLayout>

            <!-- Once it has: Movies or Series, and rows of posters, which take focus when the deck opens. -->
            <LinearLayout
                android:id="@+id/library_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/safe_horizontal"
                    android:paddingTop="@dimen/guide_top"
                    android:paddingEnd="@dimen/safe_horizontal">

                    <TextView
                        android:id="@+id/library_movies"
                        style="@style/Zapparr.Chip"
                        android:text="@string/library_movies" />

                    <TextView
                        android:id="@+id/library_series"
                        style="@style/Zapparr.Chip"
                        android:text="@string/library_series" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/library_settings"
                        style="@style/Zapparr.Chip"
                        android:layout_marginEnd="0dp"
                        android:text="@string/library_server_settings" />
                </LinearLayout>

                <androidx.leanback.widget.VerticalGridView
                    android:id="@+id/library_rows"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:focusedByDefault="true"
                    android:paddingStart="@dimen/safe_horizontal"
                    android:paddingTop="@dimen/library_rows_top"
                    android:paddingEnd="@dimen/safe_horizontal"
                    android:paddingBottom="@dimen/safe_vertical"
                    android:verticalSpacing="@dimen/row_spacing"
                    app:focusOutFront="true" />
            </LinearLayout>
        </FrameLayout>
    </tv.zapparr.home.DeckPager>
</LinearLayout>
