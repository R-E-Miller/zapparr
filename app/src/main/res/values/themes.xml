<resources>
    <!-- Zapparr's own palette. Each screen lays the palette chosen in Settings over it (Palette.*
         in palettes.xml), and the Look.* overlays below for the options that change drawing. -->
    <style name="Theme.Zapparr" parent="android:Theme.Material.NoActionBar">
        <item name="zBackground">@color/background</item>
        <item name="zBackgroundGlow">#FF1B2230</item>
        <item name="zSurface">@color/surface</item>
        <item name="zSurfaceHigh">@color/guide_airing</item>
        <item name="zAccent">@color/accent</item>
        <item name="zOnAccent">@color/on_accent</item>
        <item name="zText">@color/text_primary</item>
        <item name="zTextDim">@color/text_secondary</item>
        <item name="zTextFaint">@color/text_tertiary</item>
        <item name="zScrimStrong">#F20B0E13</item>
        <item name="zScrimMid">#CC0B0E13</item>
        <item name="zScrimLight">#550B0E13</item>
        <item name="android:colorAccent">?attr/zAccent</item>
        <item name="android:colorBackground">?attr/zBackground</item>
        <item name="android:windowBackground">@drawable/window_background</item>
        <item name="android:textColorPrimary">?attr/zText</item>
        <item name="android:textColorSecondary">?attr/zTextDim</item>
    </style>

    <!-- Parent of the Look.* overlays: the settings that change how a screen's theme draws. -->
    <style name="Look" />

    <!-- Settings > Background: Solid, instead of the glow from the top-left corner. -->
    <style name="Look.SolidBackground">
        <item name="android:windowBackground">?attr/zBackground</item>
    </style>

    <!-- Parent of the Zapparr.* styles below. -->
    <style name="Zapparr" />

    <style name="Zapparr.Tab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/tab_background</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:paddingStart">@dimen/tab_padding</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingEnd">@dimen/tab_padding</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Zapparr.Placeholder">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/safe_horizontal</item>
        <item name="android:paddingEnd">@dimen/safe_horizontal</item>
    </style>

    <style name="Zapparr.PlaceholderTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/zText</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="Zapparr.PlaceholderBody">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/zTextDim</item>
        <item name="android:textSize">@dimen/body_text</item>
    </style>

    <style name="Zapparr.Action">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:background">@drawable/action_background</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/action_text</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Zapparr.Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/chip_height</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/chip_background</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Zapparr.GuideDetail">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">@dimen/guide_detail_text</item>
    </style>

    <style name="Zapparr.FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">?attr/zTextDim</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Zapparr.Field">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/field_background</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">?attr/zText</item>
        <item name="android:textColorHint">?attr/zTextFaint</item>
        <item name="android:textSize">@dimen/body_text</item>
    </style>
</resources>
