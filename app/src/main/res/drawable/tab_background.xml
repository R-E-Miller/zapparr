<?xml version="1.0" encoding="utf-8"?>
<!-- A focused tab is a pill in the accent, like the focused Settings button; the deck on show has a
     lighter pill inside the tab bar's. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/zAccent" />
            <corners android:radius="@dimen/tab_corner" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/zSurfaceHigh" />
            <corners android:radius="@dimen/tab_corner" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
