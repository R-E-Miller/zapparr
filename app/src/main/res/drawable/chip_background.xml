<?xml version="1.0" encoding="utf-8"?>
<!-- Focused: filled with the accent. The filter in use: outlined in it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/zAccent" />
            <corners android:radius="@dimen/chip_corner" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/zSurface" />
            <stroke
                android:width="2dp"
                android:color="?attr/zAccent" />
            <corners android:radius="@dimen/chip_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/zSurface" />
            <corners android:radius="@dimen/chip_corner" />
        </shape>
    </item>
</selector>
